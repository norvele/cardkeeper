{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "sourceMap": true,
    "baseUrl": "./",
    "outDir": "./dist/",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}